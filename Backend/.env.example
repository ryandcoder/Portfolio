# Copy this file to ".env" and fill in your values. NEVER commit .env to GitHub.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
OWNER_NAME=Kim Ryan Nabo
# Comma-separated list of frontend URLs allowed to call this API (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-portfolio.vercel.app
RATE_LIMIT_PER_MIN=15
# Set to true while testing to see the real Gemini error in the chat. Set back to false for production.
DEBUG=false
# Optional: reduce thinking to speed up replies (low, medium, or high)
GEMINI_THINKING_LEVEL=low
